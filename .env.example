# ==============================================================================
# 🀄 国粹棋牌全功能服务 - 环境变量配置文件 (.env 模板)
# ==============================================================================
# 📌 Termux 部署建议直接将本文件放在 Termux 根目录: ~/.env
#    示例命令: cp ~/chess-lobby/.env.example ~/.env && nano ~/.env
#    放在 ~/.env 的好处: 代码更新、删库重拉均不会丢失你的密钥与隧道 Token！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 游戏服务器公网域名 / Telegram Webhook 回调地址
# ------------------------------------------------------------------------------
# 手机 APK 与 Telegram 官方服务器将通过此 HTTPS 域名访问本服务
# 填入你的 Cloudflare Tunnel 绑定域名或反代域名 (末尾不要加斜杠 /)
# 示例: URL="https://m.my66.cc.cd"
URL=""
APP_URL=""

# ------------------------------------------------------------------------------
# 2. Cloudflare Tunnel 隧道配置 (Termux 原生脚本自动读取并拉起隧道)
# ------------------------------------------------------------------------------
# 登录 Cloudflare Zero Trust -> Networks -> Tunnels -> 创建隧道 -> 复制 Token
# (仅粘贴 eyJhIjoi... 开头的 Token 字符串即可，不要带 cloudflared service install 等前缀)
CLOUDFLARED_TUNNEL_TOKEN=""

# 隧道传输协议调优 (针对手机/运营商禁用 QUIC UDP 场景，默认 HTTP/2 + 纯 IPv4)
CLOUDFLARED_PROTOCOL="http2"
CLOUDFLARED_EDGE_IP="4"
CLOUDFLARED_HA_CONNECTIONS="2"

# ------------------------------------------------------------------------------
# 3. Telegram Bot 机器人与管理员配置
# ------------------------------------------------------------------------------
# 在 Telegram 搜索 @BotFather 发送 /newbot 获取 Token
TELEGRAM_BOT_TOKEN=""

# 管理员 Telegram 用户名 (无需 @ 符号，多个管理员用英文逗号分隔)
# 提示: 茶客手机号白名单可直接在 Telegram Bot 中发送手机号实时授权
ADMIN_USERNAMES="admin_username"

# Telegram API 反代端点 (可选：仅当无法直连 api.telegram.org 时填写反代地址)
TELEGRAM_API_BASE=""

# 运行模式:
# • "webhook" (推荐，有公网域名时零延迟实时推送)
# • "polling" (无公网域名或内网测试时启用长轮询)
BOT_MODE="webhook"
WEBHOOK_URL=""
TELEGRAM_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 4. 后台管理 HTTP API 密钥 (强烈建议公网部署时设置高强度随机密码)
# ------------------------------------------------------------------------------
# 用于 /api/admin/*、/api/database/export、/api/apk/rebuild 等管理接口鉴权
ADMIN_API_SECRET=""

# ------------------------------------------------------------------------------
# 5. 服务端口与运行环境
# ------------------------------------------------------------------------------
PORT=3000
HOST="0.0.0.0"
NODE_ENV="production"
